TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_RETRIES=3
TELEGRAM_DELIVERY_TIMEOUT_SECONDS=25

MIN_QUOTE_VOLUME_USDT=1000000
RADAR_POOL=180
MAX_ALERTS_PER_SCAN=5
ALERT_COOLDOWN_MINUTES=180

ENABLE_15M=true
ENABLE_1H=true
ENABLE_4H=true

SIGNAL_CHECK_SECONDS=2
RADAR_REFRESH_SECONDS=60
REST_MIN_INTERVAL_MS=160
REST_418_DEFAULT_BACKOFF_SECONDS=300
BOOTSTRAP_KLINES_LIMIT=220
WS_RECONNECT_SECONDS=5

# Persistent statistics database. Mount a Railway Volume on /data.
DB_PATH=/data/bot_stats.db
RESULT_PERSIST_SECONDS=10
RESULT_TIMEOUT_15M_HOURS=12
RESULT_TIMEOUT_1H_HOURS=48
RESULT_TIMEOUT_4H_HOURS=120

PORT=8080

# Fast live event confirmation gate for ALL strategies (no forced extra candle)
# auto => 15M setups use 5M confirmation; 1H/4H setups use 15M confirmation
CONFIRM_TIMEFRAME=auto
CONFIRM_TF_15M=5m
CONFIRM_TF_1H=15m
CONFIRM_TF_4H=15m
CONFIRM_SWING_BARS=4
CONFIRM_RETEST_ATR=0.22
CONFIRM_RETEST_TOUCH_ATR=0.10
CONFIRM_MAX_EXTENSION_ATR=0.70
CONFIRM_LIVE_BREAK_ATR=0.04
CONFIRM_LIVE_RECLAIM_ATR=0.03
CONFIRM_MOMENTUM_ATR=0.12
SETUP_INVALIDATION_BUFFER_ATR=0.35
STOP_SWING_BARS=5
STOP_BUFFER_ATR=0.20
MIN_STOP_RISK_ATR=0.75
MAX_STOP_RISK_ATR=2.40
CONFIRM_TTL_15M_MINUTES=90
CONFIRM_TTL_1H_MINUTES=240
CONFIRM_TTL_4H_MINUTES=720

# v1.8 performance-aware priority from stats (14)
# Weak groups are only suppressed when the sample is large enough.
PERFORMANCE_FILTER_ENABLED=true
PERFORMANCE_MIN_EVALUATED=40
PERFORMANCE_MIN_WIN_RATE=40
PERFORMANCE_WEIGHT=0.35

# v1.10 Coin-First analysis
COIN_CONTEXT_MIN_SCORE=46
COIN_CONTEXT_STRONG_SCORE=60
COIN_CONTEXT_MAX_OPPOSITION=64
FAST_CONTEXT_CONFIRM=true
FAST_CONFIRM_MIN_SCORE=58
FAST_CONFIRM_MAX_DISTANCE_ATR=0.55
COIN_STOP_BUFFER_ATR=0.22
COIN_STOP_MAX_ATR=2.60

# Independent Trend Compression Breakout
TCB_ENABLED=true
TCB_MIN_COMPRESSION_BARS=8
TCB_BB_PERCENTILE=0.25
TCB_VOLUME_MULTIPLIER=1.35
TCB_EDGE_ATR=0.30
TCB_RANGE_RATIO=0.90

# v1.11.1 level validation
# Reject setups with risk below 0.25 ATR or above the configured maximum.

# v1.12 Full Trader Analyzer
TRADER_MIN_PLAN_SCORE=50
TRADER_SWING_LOOKBACK=80
TRADER_PIVOT_SPAN=2
TRADER_NEAR_ZONE_ATR=0.65
TRADER_MAX_IMPULSE_ATR=2.40
TRADER_ZONE_BUFFER_ATR=0.28
TRADER_BREAKOUT_BUFFER_ATR=0.08

# v1.17 REAL AGGTRADE footprint protection
FOOTPRINT_REQUIRE_FOR_EARLY=false
FOOTPRINT_SEEN_IDS_MAX=50000

# v1.18 early block reversal
EARLY_REVERSAL_ENABLED=true
EARLY_BLOCK_NEAR_ATR=0.50
EARLY_NO_CHASE_ATR=0.55
EARLY_MIN_PATTERN_SCORE=2
EARLY_STOP_BUFFER_ATR=0.16
EARLY_MIN_RR=1.0
