TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BINANCE_BASE_URL=https://fapi.binance.com
TZ=Asia/Riyadh
TIMEFRAMES=1h,4h
SCAN_SECONDS=60
MAX_CONCURRENCY=12
RADAR_POOL=140
DEEP_CANDIDATES=45
MIN_QUOTE_VOLUME_USDT=750000
MAX_ALERTS_PER_SCAN=6
COOLDOWN_MINUTES=180
EARLY_THRESHOLD=60
ENTRY_THRESHOLD=75
EXPLOSION_THRESHOLD=90
WEAKENING_DROP=14
MIN_DIRECTION_GAP=10
SEND_STARTUP_MESSAGE=true
SEND_WEAKENING_ALERTS=true
ENABLE_TEST_ENDPOINT=true
DB_PATH=data/early_explosion.db

# v1.3: منع التكرار محفوظ داخل قاعدة البيانات.
# اربط Railway Volume على /app/data حتى تبقى حالة التنبيهات بعد إعادة النشر.
FIRST_CANDLE_ENTRY_THRESHOLD=70
REQUIRE_TF_AGREEMENT_FOR_ENTRY=true
