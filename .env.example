TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MIN_QUOTE_VOLUME_USDT=1000000
RADAR_POOL=180
MAX_ALERTS_PER_SCAN=5
ALERT_COOLDOWN_MINUTES=180

ENABLE_15M=true
ENABLE_1H=true
ENABLE_4H=true

SIGNAL_CHECK_SECONDS=2
RADAR_REFRESH_SECONDS=60
REST_MIN_INTERVAL_MS=160
REST_418_DEFAULT_BACKOFF_SECONDS=300
BOOTSTRAP_KLINES_LIMIT=220
WS_RECONNECT_SECONDS=5

# Persistent statistics database. Mount a Railway Volume on /data.
DB_PATH=/data/bot_stats.db
RESULT_PERSIST_SECONDS=10
RESULT_TIMEOUT_15M_HOURS=12
RESULT_TIMEOUT_1H_HOURS=48
RESULT_TIMEOUT_4H_HOURS=120

PORT=8080

# Fast live event confirmation gate for ALL strategies (no forced extra candle)
# auto => 15M setups use 5M confirmation; 1H/4H setups use 15M confirmation
CONFIRM_TIMEFRAME=auto
CONFIRM_TF_15M=5m
CONFIRM_TF_1H=15m
CONFIRM_TF_4H=15m
CONFIRM_SWING_BARS=4
CONFIRM_RETEST_ATR=0.22
CONFIRM_RETEST_TOUCH_ATR=0.10
CONFIRM_MAX_EXTENSION_ATR=0.70
CONFIRM_LIVE_BREAK_ATR=0.04
CONFIRM_LIVE_RECLAIM_ATR=0.03
CONFIRM_MOMENTUM_ATR=0.12
SETUP_INVALIDATION_BUFFER_ATR=0.35
STOP_SWING_BARS=5
STOP_BUFFER_ATR=0.20
MIN_STOP_RISK_ATR=0.75
MAX_STOP_RISK_ATR=2.40
CONFIRM_TTL_15M_MINUTES=90
CONFIRM_TTL_1H_MINUTES=240
CONFIRM_TTL_4H_MINUTES=720
